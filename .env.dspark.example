# DeepSeek-V4-Flash-0731 on 2x DGX Spark — copy to /opt/dsv4/recipe/.env.dspark on BOTH nodes.
# Only the values that differ from the upstream example are commented here; see the upstream
# repo for the full env matrix.

# ---- Cluster ----
WORKER_HOST=<WORKER_ROCE_IP>
WORKER_DIR=/opt/dsv4/recipe
MASTER_ADDR=<HEAD_ROCE_IP>
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# ---- RoCE / NCCL ----
# VERIFY THESE. `ibdev2netdev` maps HCA -> netdev; `ip route get <WORKER_ROCE_IP>` shows which
# interface actually reaches the worker. A mismatch silently falls back to the management
# network and every tensor-parallel number becomes meaningless, with no error.
NCCL_IB_HCA=<your-hca>                 # e.g. rocep1s0f0
NCCL_SOCKET_IFNAME=<your-iface>        # e.g. enp1s0f0np0
TP_SOCKET_IFNAME=<your-iface>
GLOO_SOCKET_IFNAME=<your-iface>
WORKER_NCCL_IB_HCA=<your-hca>
WORKER_NCCL_SOCKET_IFNAME=<your-iface>
WORKER_TP_SOCKET_IFNAME=<your-iface>
WORKER_GLOO_SOCKET_IFNAME=<your-iface>
# Resolve the RoCEv2 GID index per node from sysfs. It differs per node and drifts after
# reboot — a single shared literal on both ranks can wedge NCCL at init.
NCCL_IB_GID_AUTO=1
NCCL_CROSS_NIC=1

# ---- Model / cache ----
# The directory below is mounted at /cache/huggingface inside the container.
HF_CACHE=/data/models
WORKER_HF_CACHE=/data/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
DSPARK_MODEL=/cache/huggingface/deepseek-v4-flash-0731
DSPARK_ENCODING_FILE=/cache/huggingface/deepseek-v4-flash-0731/encoding/encoding_dsv4.py
SERVED_MODEL_NAME=deepseek-v4-flash-0731
VLLM_HOST=0.0.0.0
VLLM_PORT=8888
VLLM_HOST_IP=<HEAD_ROCE_IP>
WORKER_VLLM_HOST_IP=<WORKER_ROCE_IP>

# PINNED BY DIGEST. A tag can be re-pushed; a digest cannot. Pinning the image
# transitively pins Python (3.12.13), CUDA (13.0.88), torch and every kernel.
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# ---- Parallelism (requires docker-compose.dspark.parallelism.patch) ----
# PP_SIZE=2 does NOT work for this model — see README "Findings" #1. TP=2 is the only
# working multi-node configuration. These knobs exist to let you verify that yourself.
TP_SIZE=2
PP_SIZE=1
# SPEC_DECODE=off disables DSpark. Costs 1.4-1.9x throughput but is the only configuration
# that survived a full 1-48 stream sweep. See README Finding #2.
SPEC_DECODE=on

# ---- Serving profile ----
# max_num_seqs caps concurrent sequences. It does NOT make DSpark safe: the drafter has
# killed the engine at 8 streams under max_num_seqs=32 (README Finding #2). Use
# SPEC_DECODE=off for unattended multi-user serving. Throughput peaks near 32.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
MTP_NUM_TOKENS=5
DEFAULT_THINKING=low

# ---- Anemll 0.1.1-safe runtime knobs ----
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=

VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

# CuTeDSL/b12x compile target for GB10. Without this the MoE path may JIT a slower
# W4A16 kernel mid-inference instead of GB10-native code.
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
