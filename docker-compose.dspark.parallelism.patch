diff --git a/docker-compose.dspark.yml b/docker-compose.dspark.yml
index 3ae0399..79a659d 100644
--- a/docker-compose.dspark.yml
+++ b/docker-compose.dspark.yml
@@ -87,6 +87,9 @@ services:
       # Checkpoint dspark_block_size is 5; k<5 truncates draft blocks (silent on 0.25.2 image).
       MTP_NUM_TOKENS: "${MTP_NUM_TOKENS:-5}"
       DEFAULT_THINKING: "${DEFAULT_THINKING:-low}"
+      # "off" disables DSpark speculative decoding (needed to compare TP vs PP fairly
+      # if PP cannot run the MTP draft path).
+      SPEC_DECODE: "${SPEC_DECODE:-on}"
 
     command:
       - bash
@@ -108,6 +111,8 @@ services:
           VLLM_QUANTIZATION_ARGS="--quantization modelopt_gb10_hybrid";
         fi;
         SPECULATIVE_CONFIG="{\"method\":\"dspark\",\"num_speculative_tokens\":$${MTP_NUM_TOKENS:-5},\"draft_sample_method\":\"probabilistic\"}";
+        if [ "$${SPEC_DECODE:-on}" = "off" ]; then SPEC_ARGS=""; CAPTURE_MULT=1; else SPEC_ARGS="--speculative-config $${SPECULATIVE_CONFIG}"; CAPTURE_MULT=$$(( $${MTP_NUM_TOKENS:-5} + 1 )); fi;
+        CAPTURE_SIZE=$$(( ${MAX_NUM_SEQS:-6} * CAPTURE_MULT ));
         case "$${DEFAULT_THINKING:-low}" in
           off) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":false}' ;;
           low) DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":true,"reasoning_effort":"low"}' ;;
@@ -121,20 +126,20 @@ services:
         --port ${VLLM_PORT:-8888}
         --trust-remote-code
         $${VLLM_QUANTIZATION_ARGS}
-        --tensor-parallel-size 2
-        --pipeline-parallel-size 1
+        --tensor-parallel-size ${TP_SIZE:-2}
+        --pipeline-parallel-size ${PP_SIZE:-1}
         --kv-cache-dtype nvfp4_ds_mla
         --block-size 256
         --max-model-len ${MAX_MODEL_LEN:-1048576}
         --max-num-seqs ${MAX_NUM_SEQS:-6}
         --max-num-batched-tokens ${MAX_NUM_BATCHED_TOKENS:-8192}
-        --max-cudagraph-capture-size $$(( ${MAX_NUM_SEQS:-6} * (${MTP_NUM_TOKENS:-5} + 1) ))
+        --max-cudagraph-capture-size $${CAPTURE_SIZE}
         --gpu-memory-utilization ${GPU_MEMORY_UTILIZATION:-0.80}
         --enable-prefix-caching
         --enable-prompt-tokens-details
         --async-scheduling
         --enable-chunked-prefill
-        --speculative-config "$${SPECULATIVE_CONFIG}"
+        $${SPEC_ARGS}
         --tokenizer-mode deepseek_v4
         --distributed-executor-backend mp
         --moe-backend flashinfer_b12x
